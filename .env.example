# Supabase (Dashboard → Project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Нужен для загрузки профиля через API (обходит RLS). Не показывать в клиенте!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Админ-панель: список email через запятую (доступ к /admin и /api/admin/*)
ADMIN_EMAILS=admin@example.com

# Push-уведомления (опционально): сгенерировать через npx web-push generate-vapid-keys
